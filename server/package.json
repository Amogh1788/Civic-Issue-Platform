{
  "name": "civic-issue-server",
  "version": "1.0.0",
  "description": "Backend API for the Smart Civic Issue Reporting & Resolution Platform",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node src/db/init.js",
