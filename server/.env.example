# Copy this file to .env and fill in your own values

PORT=5000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_db

# Use a long random string. Never commit your real .env file.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:5173

# Default admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@civic.local
ADMIN_PASSWORD=Admin@123

# Two reports of the same category within this many metres are treated as duplicates
DUPLICATE_RADIUS_METERS=50
